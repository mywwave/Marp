{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["marphighlights"],
  "ios": {
    "iosModuleName": "MarpHighlightsNative"
  },
  "android": {
    "androidNamespace": ["marphighlights"],
    "androidCxxLibName": "marphighlights"
  },
  "autolinking": {
    "MarpHighlights": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridMarpHighlights"
      }
    }
  },
  "ignorePaths": ["node_modules", "Vendor"]
}
